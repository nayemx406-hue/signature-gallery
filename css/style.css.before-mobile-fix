/* ===== CHECKOUT & CONFIRMATION FIX ===== */

.checkout-overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.82);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:1000;
    padding:20px;
}

.checkout-overlay.active{
    display:flex;
}

.checkout-box{
    width:min(500px,100%);
    max-height:90vh;
    overflow-y:auto;
    background:#151515;
    border:1px solid #333;
    border-radius:15px;
    padding:28px;
    position:relative;
    box-shadow:0 20px 60px rgba(0,0,0,.7);
}

.checkout-box h2{
    font-size:30px;
    margin-bottom:5px;
}

.checkout-subtitle{
    color:#888;
    margin-bottom:25px;
}

.close-checkout{
    position:absolute;
    right:18px;
    top:18px;
    background:none;
    border:0;
    color:#aaa;
    font-size:22px;
    cursor:pointer;
}

.checkout-box label{
    display:block;
    margin:15px 0 7px;
    color:#ccc;
}

.checkout-box input,
.checkout-box select,
.checkout-box textarea{
    width:100%;
    padding:13px;
    background:#222;
    color:white;
    border:1px solid #333;
    border-radius:6px;
    outline:none;
    font-size:15px;
}

.checkout-box input:focus,
.checkout-box select:focus,
.checkout-box textarea:focus{
    border-color:#d4af37;
}

.checkout-box textarea{
    height:100px;
    resize:vertical;
}

.delivery-options{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-top:8px;
}

.delivery-option{
    display:grid !important;
    grid-template-columns:auto 1fr auto;
    align-items:center;
    gap:10px;
    padding:14px;
    background:#222;
    border:1px solid #333;
    border-radius:7px;
    cursor:pointer;
}

.delivery-option:has(input:checked){
    border-color:#d4af37;
}

.delivery-option input{
    width:auto !important;
    accent-color:#d4af37;
}

.delivery-option span{
    color:#ddd;
}

.delivery-option strong{
    color:#d4af37;
}

.order-summary{
    margin-top:25px;
    border-top:1px solid #333;
}

.order-summary div{
    display:flex;
    justify-content:space-between;
    padding:12px 0;
    color:#aaa;
}

.order-summary strong{
    color:#d4af37;
}

.order-summary .grand-total{
    border-top:1px solid #333;
    margin-top:5px;
    padding-top:18px;
    font-size:20px;
    color:white;
}

.place-order-button,
.checkout-button{
    width:100%;
    margin-top:20px;
    padding:15px;
    border:0;
    border-radius:6px;
    background:#d4af37;
    color:#111;
    font-weight:bold;
    font-size:16px;
    cursor:pointer;
}

.place-order-button:hover,
.checkout-button:hover{
    opacity:.85;
}

/* ===== ORDER CONFIRMATION ===== */

.confirmation-overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.85);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:2000;
    padding:20px;
}

.confirmation-overlay.active{
    display:flex;
}

.confirmation-box{
    width:min(480px,100%);
    max-height:90vh;
    overflow-y:auto;
    background:#151515;
    border:1px solid #333;
    border-radius:16px;
    padding:30px;
    text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.7);
}

.success-icon{
    width:65px;
    height:65px;
    margin:0 auto 20px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:#d4af37;
    color:#111;
    font-size:35px;
    font-weight:bold;
}

.confirmation-box h2{
    font-size:30px;
}

.confirmation-text{
    color:#888;
    margin:10px 0 25px;
}

.order-id-box{
    background:#222;
    padding:15px;
    border-radius:8px;
    color:#888;
    margin-bottom:20px;
}

.order-id-box strong{
    display:block;
    color:#d4af37;
    font-size:20px;
    margin-top:5px;
}

.confirmation-row{
    display:flex;
    justify-content:space-between;
    gap:15px;
    text-align:left;
    padding:12px 0;
    border-bottom:1px solid #292929;
}

.confirmation-row span{
    color:#888;
}

.confirmation-row strong{
    color:#ddd;
    text-align:right;
    max-width:60%;
    word-break:break-word;
}

.total-row{
    margin-top:8px;
    border:0;
    font-size:20px;
}

.total-row strong{
    color:#d4af37;
}

.close-confirmation{
    width:100%;
    margin-top:20px;
    padding:14px;
    border:0;
    border-radius:6px;
    background:#d4af37;
    color:#111;
    font-weight:bold;
    cursor:pointer;
}

@media(max-width:600px){

    .checkout-overlay,
    .confirmation-overlay{
        padding:12px;
    }

    .checkout-box,
    .confirmation-box{
        padding:22px;
        max-height:92vh;
    }

    .checkout-box h2,
    .confirmation-box h2{
        font-size:27px;
    }

    .confirmation-row{
        gap:10px;
    }

    .confirmation-row strong{
        max-width:58%;
    }
}

