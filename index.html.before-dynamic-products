<!-- CHECKOUT -->

<div class="checkout-overlay" id="checkoutOverlay">

    <div class="checkout-box">

        <button class="close-checkout" onclick="closeCheckout()">✕</button>

        <h2>Checkout</h2>
        <p class="checkout-subtitle">Enter your delivery information</p>

        <form id="checkoutForm">

            <label>Full Name</label>
            <input
                type="text"
                id="customerName"
                placeholder="Your name"
                required
            >

            <label>Phone Number</label>
            <input
                type="tel"
                id="customerPhone"
                placeholder="01XXXXXXXXX"
                required
            >

            <label>District</label>
            <select id="district" required>
                <option value="">Select District</option>
                <option>Sylhet</option>
                <option>Dhaka</option>
                <option>Chattogram</option>
                <option>Rajshahi</option>
                <option>Khulna</option>
                <option>Barishal</option>
                <option>Rangpur</option>
                <option>Mymensingh</option>
            </select>

            <label>Delivery Area</label>

            <div class="delivery-options">

                <label class="delivery-option">
                    <input
                        type="radio"
                        name="delivery"
                        value="inside"
                        checked
                        onchange="updateDelivery()"
                    >
                    <span>Inside Sylhet</span>
                    <strong>৳ 60</strong>
                </label>

                <label class="delivery-option">
                    <input
                        type="radio"
                        name="delivery"
                        value="outside"
                        onchange="updateDelivery()"
                    >
                    <span>Outside Sylhet</span>
                    <strong>৳ 120</strong>
                </label>

            </div>

            <label>Delivery Address</label>
            <textarea
                id="address"
                placeholder="House, Road, Area..."
                required
            ></textarea>

            <div class="order-summary">
                <div>
                    <span>Products</span>
                    <strong>৳ <span id="checkoutSubtotal">0</span></strong>
                </div>

                <div>
                    <span>Delivery</span>
                    <strong>৳ <span id="deliveryCharge">60</span></strong>
                </div>

                <div class="grand-total">
                    <span>Total</span>
                    <strong>৳ <span id="checkoutTotal">0</span></strong>
                </div>
            </div>

            <button type="submit" class="place-order-button">
                Place Order
            </button>

        </form>

    </div>

</div>

<!-- ORDER CONFIRMATION -->

<div class="confirmation-overlay" id="confirmationOverlay">

